{
  "name": "pluck",
  "private": true,
  "type": "module",
  "bin": {
    "pluck": "scripts/pluck.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "probe": "tsx scripts/probe-isomorphic-git.ts",
    "test:repo": "tsx scripts/test-local-repo.ts",
    "test:stress": "tsx scripts/stress-multi-agent.ts",
    "pluck": "tsx scripts/pluck.ts",
    "dev": "wrangler dev",
    "dev:test": "wrangler dev --config wrangler.test.jsonc",
    "deploy": "wrangler deploy",
    "deploy:test": "wrangler deploy --config wrangler.test.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply pluck --local",
    "db:migrate:remote": "wrangler d1 migrations apply pluck --remote",
    "db:migrate:test": "wrangler d1 migrations apply pluck-test --remote --config wrangler.test.jsonc",
    "queues:create:test": "wrangler queues create pluck-test-artifacts-events"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "isomorphic-git": "^1.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.43.0"
  }
}
